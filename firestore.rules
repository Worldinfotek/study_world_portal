rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Master Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'miftech.software.engineer@gmail.com',
          'musadixsolution@gmail.com',
          'admin@studyworld.pk'
        ] ||
        (hasUserDoc() && (
          getUserDoc().role in ['Admin', 'admin', 'Head Office', 'head_office']
        ))
      );
    }

    // Readiness Probe
    match /test/{testId} {
      allow read: if true;
    }

    // ==========================================
    // USERS COLLECTION
    // Role-based access and privilege escalation guard
    // ==========================================
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !('password' in incoming()) &&
          incoming().role == 'User'
        )
      );

      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !('password' in incoming()) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['role', 'franchise_id', 'status', 'export_permission'])
        )
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // STUDENT LEADS COLLECTION
    // Sensitive Student PII & Franchise Isolation
    // ==========================================
    match /student_leads/{leadId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (resource.data.student_email != null && resource.data.student_email == request.auth.token.email) ||
        (resource.data.email != null && resource.data.email == request.auth.token.email) ||
        (resource.data.counselor_id != null && resource.data.counselor_id == request.auth.uid) ||
        (resource.data.counselor_email != null && resource.data.counselor_email == request.auth.token.email) ||
        (hasUserDoc() && getUserDoc().role == 'Franchise Admin' && resource.data.franchise_id == getUserDoc().franchise_id)
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        (hasUserDoc() && getUserDoc().role == 'Franchise Admin' && resource.data.franchise_id == getUserDoc().franchise_id) ||
        (resource.data.counselor_id == request.auth.uid || resource.data.counselor_email == request.auth.token.email) ||
        (resource.data.email == request.auth.token.email || resource.data.student_email == request.auth.token.email)
      );

      allow create: if isSignedIn() && isValidId(leadId) && !('password' in incoming());

      allow update: if isSignedIn() && isValidId(leadId) && !('password' in incoming()) && (
        isAdmin() ||
        (resource.data.counselor_id == request.auth.uid || resource.data.counselor_email == request.auth.token.email) ||
        (hasUserDoc() && getUserDoc().role == 'Franchise Admin' && resource.data.franchise_id == getUserDoc().franchise_id)
      );

      allow delete: if isSignedIn() && (
        isAdmin() ||
        (hasUserDoc() && getUserDoc().role == 'Franchise Admin' && resource.data.franchise_id == getUserDoc().franchise_id)
      );
    }

    // ==========================================
    // UNIVERSITIES COLLECTION (Catalog)
    // ==========================================
    match /universities/{universityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // COURSES COLLECTION (Catalog)
    // ==========================================
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // COUNTRIES COLLECTION (Destinations & Currencies)
    // ==========================================
    match /countries/{countryCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // FRANCHISES COLLECTION (Branch Offices)
    // ==========================================
    match /franchises/{franchiseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==========================================
    // USER COUNTRY ASSIGNMENTS
    // ==========================================
    match /user_country_assignments/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // ==========================================
    // COUNSELING MEETINGS COLLECTION
    // ==========================================
    match /counseling_meetings/{meetingId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.counselor_id == request.auth.uid || resource.data.counselor_email == request.auth.token.email) ||
        resource.data.student_email == request.auth.token.email
      );
      allow create, update: if isSignedIn() && isValidId(meetingId) && (
        isAdmin() ||
        (incoming().counselor_id == request.auth.uid || incoming().counselor_email == request.auth.token.email) ||
        incoming().student_email == request.auth.token.email
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.counselor_id == request.auth.uid || resource.data.counselor_email == request.auth.token.email)
      );
    }

    // ==========================================
    // SEARCH ANALYTICS
    // ==========================================
    match /search_analytics/{analyticId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // SYSTEM SETTINGS & INITIALIZATION
    // ==========================================
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }
  }
}
