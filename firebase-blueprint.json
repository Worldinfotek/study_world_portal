{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "head_office", "franchise_admin", "counselor"] },
        "franchise_id": { "type": "string", "maxLength": 64 },
        "franchise_name": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "University": {
      "title": "University",
      "description": "Partner university record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 256 },
        "country": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 64 },
        "campus": { "type": "string", "maxLength": 128 },
        "ranking": { "type": "number" },
        "world_rank": { "type": "number" },
        "logo_url": { "type": "string", "maxLength": 512 },
        "website_url": { "type": "string", "maxLength": 512 },
        "commission_rate": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "name", "country", "city"]
    },
    "Course": {
      "title": "Course",
      "description": "Academic course offering by a partner university",
      "type": "object",
      "properties": {
        "course_id": { "type": "string", "maxLength": 64 },
        "university_id": { "type": "string", "maxLength": 64 },
        "university_name": { "type": "string", "maxLength": 256 },
        "country": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 64 },
        "course_name": { "type": "string", "maxLength": 256 },
        "discipline": { "type": "string", "maxLength": 128 },
        "level": { "type": "string", "maxLength": 64 },
        "duration_years": { "type": "string", "maxLength": 64 },
        "annual_fee": { "type": "string", "maxLength": 64 },
        "currency": { "type": "string", "maxLength": 16 },
        "scholarship_available": { "type": "string", "maxLength": 128 },
        "ielts_requirement": { "type": "string", "maxLength": 64 },
        "toefl_requirement": { "type": "string", "maxLength": 64 },
        "duolingo_requirement": { "type": "string", "maxLength": 64 },
        "pte_requirement": { "type": "string", "maxLength": 64 },
        "moi_accepted": { "type": "boolean" },
        "gpa_requirement": { "type": "string", "maxLength": 64 },
        "percentage_requirement": { "type": "string", "maxLength": 64 },
        "intakes": { "type": "string", "maxLength": 128 },
        "application_deadline": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["course_id", "university_id", "university_name", "country", "course_name", "discipline", "level"]
    },
    "StudentLead": {
      "title": "StudentLead",
      "description": "Student lead and course application workflow record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "student_name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 64 },
        "counselor_id": { "type": "string", "maxLength": 128 },
        "counselor_name": { "type": "string", "maxLength": 128 },
        "counselor_email": { "type": "string", "maxLength": 256 },
        "franchise_id": { "type": "string", "maxLength": 64 },
        "franchise_name": { "type": "string", "maxLength": 128 },
        "course_id": { "type": "string", "maxLength": 64 },
        "course_name": { "type": "string", "maxLength": 256 },
        "university_id": { "type": "string", "maxLength": 64 },
        "university_name": { "type": "string", "maxLength": 256 },
        "destination_country": { "type": "string", "maxLength": 64 },
        "target_intake": { "type": "string", "maxLength": 64 },
        "academic_score": { "type": "string", "maxLength": 64 },
        "english_test_score": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 64 },
        "priority": { "type": "string", "enum": ["Urgent", "High", "Medium", "Low"] },
        "request_type": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 2048 },
        "meet_link": { "type": "string", "maxLength": 512 },
        "calendar_event_id": { "type": "string", "maxLength": 128 },
        "google_doc_id": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "student_name", "email", "phone", "counselor_id", "franchise_id", "course_id", "university_id", "status"]
    },
    "CounselingMeeting": {
      "title": "CounselingMeeting",
      "description": "Counseling session integrated with Google Meet & Google Calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "lead_id": { "type": "string", "maxLength": 64 },
        "student_name": { "type": "string", "maxLength": 128 },
        "student_email": { "type": "string", "maxLength": 256 },
        "counselor_id": { "type": "string", "maxLength": 128 },
        "counselor_email": { "type": "string", "maxLength": 256 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "meet_uri": { "type": "string", "maxLength": 512 },
        "calendar_event_id": { "type": "string", "maxLength": 128 },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "created_at": { "type": "string" }
      },
      "required": ["id", "student_name", "student_email", "counselor_email", "title", "start_time", "end_time"]
    },
    "Franchise": {
      "title": "Franchise",
      "description": "Regional branch office record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 256 },
        "code": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 64 },
        "country": { "type": "string", "maxLength": 64 },
        "address": { "type": "string", "maxLength": 256 },
        "contact_person": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "code", "city", "country"]
    },
    "Country": {
      "title": "Country",
      "description": "Global study destinations, ISO codes, currencies, and visa parameters",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 8 },
        "name": { "type": "string", "maxLength": 128 },
        "flag": { "type": "string", "maxLength": 32 },
        "currency": { "type": "string", "maxLength": 16 },
        "currency_symbol": { "type": "string", "maxLength": 16 },
        "active_universities_count": { "type": "number" },
        "visa_processing_weeks": { "type": "string", "maxLength": 128 },
        "post_study_work_visa": { "type": "string", "maxLength": 256 },
        "psw_duration": { "type": "string", "maxLength": 128 },
        "financial_requirement_notes": { "type": "string", "maxLength": 512 },
        "active": { "type": "boolean" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["code", "name", "currency", "currency_symbol"]
    },
    "UserCountryAssignment": {
      "title": "UserCountryAssignment",
      "description": "Mapping of destination countries assigned to counselors and users",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userRole": { "type": "string", "maxLength": 64 },
        "franchise_id": { "type": "string", "maxLength": 64 },
        "franchise_name": { "type": "string", "maxLength": 128 },
        "assignedCountryCodes": { "type": "array" },
        "assignedCountryNames": { "type": "array" },
        "allCountriesAssigned": { "type": "boolean" },
        "assigned_by": { "type": "string", "maxLength": 256 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["userId", "userName", "userEmail", "assignedCountryCodes"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "System initialization state, metadata, and deleted records tombstones",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "initialized": { "type": "boolean" },
        "schema_version": { "type": "number" },
        "initialized_at": { "type": "string" },
        "initialized_by": { "type": "string", "maxLength": 128 },
        "demo_seeded": { "type": "boolean" },
        "deleted_ids": { "type": "array" },
        "updated_at": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "System initialization and configuration state"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile with role information"
    },
    "/universities/{universityId}": {
      "schema": { "$ref": "#/entities/University" },
      "description": "Partner university registry"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "University courses catalog"
    },
    "/student_leads/{leadId}": {
      "schema": { "$ref": "#/entities/StudentLead" },
      "description": "Student leads and counseling applications"
    },
    "/counseling_meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/CounselingMeeting" },
      "description": "Counseling video & calendar appointments"
    },
    "/franchises/{franchiseId}": {
      "schema": { "$ref": "#/entities/Franchise" },
      "description": "Branch offices"
    },
    "/countries/{countryCode}": {
      "schema": { "$ref": "#/entities/Country" },
      "description": "Global study destinations and currency registry"
    },
    "/user_country_assignments/{userId}": {
      "schema": { "$ref": "#/entities/UserCountryAssignment" },
      "description": "Country assignment per user account"
    }
  }
}
