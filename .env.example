# Create this file as ".env" in the Plesk site root (same folder as package.json).
# Do not upload .env.local. Do not set PORT on Plesk — iisnode provides it.

NODE_ENV=production
SQL_HOST=127.0.0.1
SQL_PORT=1433
SQL_DB_NAME=study_world_portal
SQL_AUTH=sql
SQL_USER=portal_admin
SQL_PASSWORD="your_sql_password"

# If Plesk and SQL Server are on different machines, use:
# SQL_HOST=74.50.79.178
