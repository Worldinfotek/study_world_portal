# Copy to .env on the Plesk server, or set these in Plesk > Node.js > Custom environment variables.
# Do not upload .env.local.

NODE_ENV=production
PORT=3000

# On the Plesk machine itself use the local instance name.
# From your own PC you can keep 74.50.79.178
SQL_HOST=.\MSSQLSERVER2022
SQL_DB_NAME=study_world_portal
SQL_AUTH=sql
SQL_USER=portal_admin
SQL_PASSWORD=

GEMINI_API_KEY=
