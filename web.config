<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="dist/server.cjs" verb="*" modules="iisnode" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeApp" stopProcessing="true">
          <match url="/*" />
          <action type="Rewrite" url="dist/server.cjs" />
        </rule>
      </rules>
    </rewrite>
    <iisnode
      node_env="production"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="true"
      watchedFiles="web.config;dist\server.cjs"
    />
  </system.webServer>
</configuration>
